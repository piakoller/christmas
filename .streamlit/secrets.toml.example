# Vorlage für die Secrets. Lokal nach .streamlit/secrets.toml kopieren,
# auf Streamlit Cloud unter App -> Settings -> Secrets einfügen. Echte Werte NIE committen.

[supabase]
url = "https://DEIN-PROJEKT.supabase.co"
key = "sb_secret_..."          # Secret key (oder Legacy service_role), NICHT der publishable/anon key

[passwords]
Dieter = "..."
Gudrun = "..."
Lukas = "..."
Pia = "..."
Emmy = "..."
Tim = "..."

[features]
advent_calendar = false        # auf true setzen, sobald die Fotos in images/ liegen

# Vorlage für die Secrets. Lokal nach .streamlit/secrets.toml kopieren,
# auf Streamlit Cloud unter App -> Settings -> Secrets einfügen. Echte Werte NIE committen.

[supabase]
url = "https://DEIN-PROJEKT.supabase.co"
key = "sb_secret_..."          # Secret key (oder Legacy service_role), NICHT der publishable/anon key

[auth]
# Jede Person legt beim ersten Login selbst eine PIN an. Dafür braucht sie diesen
# Familien-Code (z. B. per WhatsApp an die Familie schicken).
family_code = "..."
# Schlüssel für "Angemeldet bleiben" (lange Zufallszeichenkette). Ändern meldet alle ab.
# Fehlt er, wird der Supabase-Key verwendet.
cookie_secret = "..."

# Optional, alte Variante: feste PINs. Gilt nur, bis die Person selbst eine PIN anlegt
# oder Dieter/Gudrun sie zurücksetzen. Kann gelöscht werden, sobald alle eine eigene PIN haben.
# [passwords]
# Dieter = "...."

[features]
advent_calendar = false        # auf true setzen, sobald die Fotos in images/ liegen
